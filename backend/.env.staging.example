# Copy only into /var/www/dearyou-staging/backend/.env.
# Generate a NEW APP_KEY and use a NEW database and password.
APP_NAME="DearYou Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.dearyous.app
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
# The log mail transport writes at debug level. Keep this while MAIL_MAILER=log.
LOG_LEVEL=debug
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dearyou_staging
DB_USERNAME=dearyou_staging
DB_PASSWORD="replace-with-a-unique-staging-database-password"

# Seed once before caching configuration. Never reuse the live admin password.
ADMIN_EMAIL=admin@staging.dearyou.test
ADMIN_PASSWORD="replace-with-a-unique-staging-admin-password"
ADMIN_ALLOWED_IPS=

SESSION_DRIVER=database
SESSION_COOKIE=dearyou_staging_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=dearyou_staging_cache_
QUEUE_CONNECTION=database
DB_QUEUE=default
FILESYSTEM_DISK=public

# No outgoing mail by default. After the staging worker processes a job,
# its mail is written to backend/storage/logs/dearyou-mail.log.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=hello@staging.dearyou.test
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
FEEDBACK_NOTIFY_EMAIL=feedback@staging.dearyou.test
FEEDBACK_EMAIL_HOURLY_LIMIT=3
FEEDBACK_EMAIL_DAILY_LIMIT=5
FEEDBACK_EMAIL_MAX_AGE_HOURS=24

DEARYOU_BACKUP_DIR=/var/backups/dearyou-staging
DEARYOU_STORAGE_LIMIT_MB=250
DEARYOU_STORAGE_CLEANUP_GRACE_DAYS=7
