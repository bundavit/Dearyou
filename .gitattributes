* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Keep GitHub language stats focused on DearYou source code.
backend/public/vendor/** linguist-vendored
backend/public/assets/dearyou/app.js linguist-generated=true
backend/resources/js/** linguist-generated=true
backend/vite.config.js linguist-generated=true
deploy/*.sh linguist-generated=true

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
